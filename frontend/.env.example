# Public URL of this site, used for canonical links, the sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile site key (public). Cloudflare's always-pass test key is 1x00000000000000000000AA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Base URL of the Express API, read on the server only.
API_URL=http://localhost:4000
