NODE_ENV=development
PORT=4000

# MongoDB connection string (local or hosted). Never commit the real value.
MONGODB_URI=mongodb://127.0.0.1:27017/?directConnection=true
MONGODB_DB=cm-kerala

# At least 32 random characters. Generate one with: openssl rand -hex 48
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=28800

# Origins allowed to call the API from a browser, comma separated.
CORS_ORIGIN=http://localhost:3000
# Reverse proxies in front of the API. The Next.js server counts as one.
TRUST_PROXY=1

# Cloudflare Turnstile secret key (required in production).
# For local testing Cloudflare publishes an always-pass secret: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=

# AI Grievance Assistant, any OpenAI compatible chat completions API.
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
DEEPSEEK_API_KEY=

UPLOAD_MAX_MB=5
SLA_DAYS=30
