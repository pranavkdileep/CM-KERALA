# Combined reference for every setting in the project. No real secrets here.
# Copy the BACKEND block to backend/.env and the FRONTEND block to frontend/.env.local.

# ----------------------------- BACKEND (backend/.env) -----------------------------
NODE_ENV=development
PORT=4000

# MongoDB connection string. Never commit the real value.
MONGODB_URI=mongodb://127.0.0.1:27017/?directConnection=true
MONGODB_DB=cm-kerala

# At least 32 random characters: openssl rand -hex 48
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=28800

CORS_ORIGIN=http://localhost:3000
# Proxies in front of the API (the Next.js server counts as one)
TRUST_PROXY=1

# Cloudflare Turnstile SECRET key. Local testing: 1x0000000000000000000000000000000AA (always passes)
TURNSTILE_SECRET_KEY=

# AI Grievance Assistant. Any OpenAI compatible API. Leave the key empty for the labelled fallback.
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
DEEPSEEK_API_KEY=

UPLOAD_MAX_MB=5
SLA_DAYS=30

# ----------------------------- FRONTEND (frontend/.env.local) -----------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Turnstile SITE key (public). Test key that always passes: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Where the Next.js server reaches the API
API_URL=http://localhost:4000
